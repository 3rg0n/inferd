# Rust build output
/target/
**/*.rs.bk
Cargo.lock.bak
# cargo-fuzz state (corpus + crash artifacts; harness Cargo.toml +
# fuzz_targets/ are tracked, but the per-run state is not).
crates/*/fuzz/target/
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/
crates/*/fuzz/Cargo.lock

# Local-only scratch (validation scripts, tarball stagings, etc).
.local/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.gpg
*.asc
*secret*
id_rsa
id_rsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
credentials.json
secrets.yaml

# Model artefacts (large, pulled at install time)
*.gguf
*.safetensors
/models/

# Test sandboxes
/.test/
/tmp/

# Local reference material
.references/

# Coverage / profiling
*.profraw
/coverage/

# transient spec-validation harness (not shipped)
tmp-spec-validation/

# Local scratch (vision proof harnesses, ad-hoc daemon logs) — not committed
.tmp-vision/

# v0.6 validation scratch (tarballs, harnesses)
.tmp-v06val/
