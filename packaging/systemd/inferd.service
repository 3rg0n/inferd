# inferd-daemon systemd unit (per-user variant).
#
# Install as:
#   ~/.config/systemd/user/inferd.service
# then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now inferd
#
# THREAT_MODEL F-16: this unit applies the hardening directives
# documented in the threat model. Anything off this baseline weakens
# the security posture; change deliberately.
#
# v0.1 ships only the `mock` backend by default; for real inference
# set --backend llamacpp, --model-path, and the model SHA-256 below.

[Unit]
Description=inferd local inference daemon
Documentation=https://github.com/3rg0n/inferd
After=network.target

# Crash-loop containment: if the unit fails 3 times within 60s,
# systemd stops auto-restarting until the operator intervenes. Without
# this, a daemon that pre-empts on missing model + RestartSec=2 will
# hammer the journal and burn CPU forever.
StartLimitBurst=3
StartLimitIntervalSec=60s

[Service]
Type=simple
# %t expands to /run/user/<uid>/, which `RuntimeDirectory=inferd`
# below auto-creates with mode 0700 before ExecStart. This matches
# the resolution chain frozen in `docs/protocol-v1.md`
# §"Default endpoint resolution" — clients compute the same path.
#
# `--group` is intentionally omitted from the default unit. Single-
# user systems don't need an `inferd-users` group: `RuntimeDirectory=`
# already grants the sockets `0700` ownership to the daemon user only,
# which is the most-restrictive policy. Operators on multi-user hosts
# who want a non-default group (e.g. for a service account that
# shares the daemon) `groupadd inferd-users` first and append
# `--group inferd-users` to the ExecStart line below.
ExecStart=%h/.local/bin/inferd-daemon \
    --backend mock \
    --lock %t/inferd/inferd.lock \
    --uds %t/inferd/infer.sock \
    --admin-addr %t/inferd/admin.sock
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

# State + log directories under XDG. RuntimeDirectory grants 0750
# under /run/user/<uid>/.
RuntimeDirectory=inferd
StateDirectory=inferd
LogsDirectory=inferd

Environment=INFERD_LOG=info
Environment=INFERD_LOG_DIR=%S/inferd/logs

# Hardening (THREAT_MODEL F-16). The directives below are the
# subset that works under `systemctl --user` on stock systemd
# without requiring capabilities the user doesn't have.
#
# Many hardening directives that look right for a daemon
# (PrivateTmp=, ProtectSystem=strict, PrivateDevices=,
# ProtectControlGroups=, ProtectKernel*=, RestrictNamespaces=,
# MemoryDenyWriteExecute=, CapabilityBoundingSet=) require
# CAP_SYS_ADMIN or similar to *set up* the namespace/mount/cgroup
# barriers — capabilities a non-root user has no way to grant.
# On systemd <= 250 (and several modern stock distros) these fail
# unit-level validation with `status=218/CAPABILITIES` before
# ExecStart runs even though the daemon itself doesn't need root.
#
# For a system-unit deployment (multi-user host, root install via
# `User=inferd-daemon` in a unit at /etc/systemd/system/), the full
# F-16 hardening set is supported. See
# `packaging/systemd/inferd.service.system` for that variant
# (forthcoming).
NoNewPrivileges=yes
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# `ReadWritePaths=` is only meaningful with `ProtectSystem=strict`,
# which we drop above for per-user reasons. RuntimeDirectory= and
# StateDirectory= already grant write access where it's needed.

[Install]
WantedBy=default.target
