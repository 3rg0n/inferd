<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  inferd-daemon LaunchAgent (per-user, runs in login session).

  DO NOT edit placeholders by hand — use the install script instead:

    packaging/launchd/install-launchagent.sh \
      [/path/to/inferd-daemon] \
      [/path/to/model.gguf]

  The script substitutes the current user's HOME and TMPDIR, installs
  the plist, and bootstraps the agent. When a model path is supplied
  (or auto-detected from ~/.inferd/config.json) it also writes
  __BACKEND__ and __MODEL_PATH__ so the daemon starts with real
  inference instead of the mock backend.

  Manual install (for reference only):
    sed -e "s|__HOME__|$HOME|g" \
        -e "s|__TMPDIR__|$(getconf DARWIN_USER_TEMP_DIR)|g" \
        -e "s|__BIN__|/usr/local/bin/inferd-daemon|g" \
        -e "s|__BACKEND__|llamacpp|g" \
        -e "s|__MODEL_PATH__|/path/to/model.gguf|g" \
      packaging/launchd/io.inferd.daemon.plist \
      > ~/Library/LaunchAgents/io.inferd.daemon.plist
    launchctl enable gui/$(id -u)/io.inferd.daemon
    launchctl bootstrap gui/$(id -u) \
      ~/Library/LaunchAgents/io.inferd.daemon.plist

  WHY __TMPDIR__ for sockets and lock:
    launchd does NOT expand $TMPDIR, ${HOME}, or ~ in ProgramArguments,
    EnvironmentVariables values, StandardOutPath, or StandardErrorPath.
    The sockets and lock live under TMPDIR because macOS rotates per-user
    temp dirs per login — the same path the daemon's default_admin_addr()
    uses — so the plist, daemon default, and Go client default all agree.

  THREAT_MODEL F-16: launchd has a smaller hardening surface than
  systemd. Controls applied here:
    - Per-user LaunchAgent (no LaunchDaemon, no root).
    - Sandboxed via the existing macOS app-sandbox framework when
      the user installs the signed bundle from a release tarball.
      Unsigned local builds still run.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.inferd.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BIN__</string>
        <string>--lock</string>
        <string>__TMPDIR__inferd/inferd.lock</string>
        <string>--uds</string>
        <string>__TMPDIR__inferd/infer.sock</string>
        <string>--admin-addr</string>
        <string>__TMPDIR__inferd/admin.sock</string>
        <string>--backend</string>
        <string>__BACKEND__</string>
        <string>--model-path</string>
        <string>__MODEL_PATH__</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>INFERD_LOG</key>
        <string>info</string>
        <key>INFERD_LOG_DIR</key>
        <string>__HOME__/Library/Logs/inferd</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!--
      ThrottleInterval + StartCalendarInterval are absent: launchd's
      own crash-loop containment (5 starts in 10 s) covers the
      equivalent of systemd's StartLimitBurst. ThrottleInterval=2
      adds a 2-second floor per restart.
    -->
    <key>ThrottleInterval</key>
    <integer>2</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/inferd/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/inferd/stderr.log</string>

    <!--
      ProcessType=Adaptive lets macOS apply timer-coalescing /
      App Nap when the daemon is idle. The lifecycle's accept loop
      is event-driven so this is safe.
    -->
    <key>ProcessType</key>
    <string>Adaptive</string>
</dict>
</plist>
